# Copy to .env before running the full Docker Compose stack.
# Replace this value with a strong random secret before exposing the app.
BETTER_AUTH_SECRET=replace-with-a-random-secret

# Public URL used by the self-hosted web container.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Optional hosted content/search integrations.
NEXT_PUBLIC_MARBLE_API_URL=https://api.marblecms.com
MARBLE_WORKSPACE_KEY=placeholder
FREESOUND_CLIENT_ID=placeholder
FREESOUND_API_KEY=placeholder

# Optional analytics. Leave empty to keep Databuddy disabled.
NEXT_PUBLIC_DATABUDDY_CLIENT_ID=
